  {
    "requestId": "lp-031",
    "actor": "practitioner",
    "patient": "patient",
    "action": {
      "type": "decide",
      "disposition": "defer",
      "rationale": "24 weeks pregnant with lumbar pain: abdominal and lumbosacral points are to be avoided after the first trimester (TCMPB advisory 2021, §4.1.4). No needling; antenatal physiotherapy and liaison with her obstetric team."
    }
  },
  {
    "requestId": "lp-032",
    "actor": "practitioner",
    "patient": "patient",
    "action": {
      "type": "explain",
      "topics": [
        "alternatives",
        "evidence"
      ],
      "text": "Because you are past the first three months of pregnancy, I won't put needles in your lower back or abdomen: our guidance is to avoid those areas from now on. The evidence for acupuncture in back pain in pregnancy is limited anyway. What helps most is antenatal physiotherapy — exercises, a support belt and advice on posture and sleep. I'll write to your obstetric team so they know about the pain and can arrange that."
    }
  },
  {
    "requestId": "lp-033",
    "actor": "practitioner",
    "patient": "patient",
    "action": {
      "type": "refer",
      "to": "obstetrics",
      "urgency": "routine",
      "reason": "Pregnancy-related low back pain at 24 weeks, no red flags. Acupuncture deferred: lumbosacral and abdominal needling is avoided after the first trimester. Please consider antenatal physiotherapy."
    }
  },
