      "chiefComplaint": "Back pain much worse for two days, after lifting a box",
      "persona": {
        "affect": "anxious",
        "openingLine": "Doctor, my back got much worse after I lifted a box — and something feels wrong with my legs."
      }
    },
    "history": [
      {
        "id": "hx-chief",
        "answer": "My back has ached for months, but two days ago I lifted a heavy box and it got much worse."
      },
      {
        "id": "hx-onset",
        "answer": "It suddenly got much worse two days ago, after lifting a box."
      },
      {
        "id": "hx-radiation",
        "answer": "Since yesterday both legs feel heavy, and the backs of my thighs are numb."
      },
      {
        "id": "hx-cauda",
        "answer": "Now that you ask — since this morning it's numb around my bottom, and I haven't been able to pass urine properly."
      },
      {
        "id": "hx-weakness",
        "answer": "My legs feel weaker, especially going down stairs."
      }
    ],
    "exam": [
      {
        "id": "ex-neuro",
