        "abnormal": true
      },
      {
        "id": "ex-slr",
        "finding": "Positive on both sides at about 40°.",
        "abnormal": true
      }
    ],
    "debrief": {
      "title": "Suspected cauda equina syndrome",
      "conclusion": "Saddle anaesthesia, urinary retention and bilateral leg symptoms after lifting: an emergency referral without needling.",
      "keyReasoning": [
        "Saddle anaesthesia and bladder dysfunction are red flags for cauda equina syndrome.",
        "Delay risks permanent loss of bladder, bowel and sexual function."
      ],
      "teachingPoints": [
        "Ask every back-pain patient about saddle numbness and bladder or bowel change.",
        "Refer to the Emergency Department at once."
      ]
    }
  },
