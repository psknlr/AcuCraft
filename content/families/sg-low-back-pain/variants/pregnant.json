{
  "schema": "acucraft/variant@1",
  "id": "pregnant",
  "title": "Twenty-four weeks pregnant",
  "kind": "risk",
  "purpose": "Pregnancy as a risk factor and a position constraint: she is 24 weeks pregnant, past the first trimester, so abdominal and lumbosacral needling is avoided (TCMPB advisory 2021, §4.1.4: a rule in force, judged by region, whatever point is named) and she should not lie prone; LI4 and SP6 are cautioned. Acceptable: deferral with liaison with her obstetric team, or declining with other options.",
  "case": {
    "history": [
      {
        "id": "hx-pregnancy",
        "answer": "Yes — I'm 24 weeks pregnant. The baby is fine; my obstetrician is happy."
      },
      {
        "id": "hx-chief",
        "answer": "My lower back has ached since I got pregnant, worse this last month. A friend said acupuncture helped her."
      },
      {
        "id": "hx-onset",
        "answer": "It came on gradually in the pregnancy, worse in the last month. No injury."
      },
      {
        "id": "hx-meds",
        "answer": "Prenatal vitamins only. No blood thinners."
      }
    ],
    "exam": [
      {
        "id": "ex-inspect-back",
        "finding": "Gravid abdomen consistent with about 24 weeks; increased lumbar lordosis; skin intact."
      },
      {
        "id": "ex-palpate-back",
        "finding": "No midline bony tenderness. Tight, tender right lumbar muscles, maximal at one point at the level of L3, about four finger-breadths lateral to the spine."
      }
    ],
    "patient": {
      "weightKg": 67
    },
    "debrief": {
      "title": "Low back pain at 24 weeks of pregnancy",
      "conclusion": "Mechanical low back pain in the second trimester: no needling of the lower back or abdomen; defer, explain the options and liaise with her obstetric team.",
      "keyReasoning": [
        "Past the first trimester, abdominal and lumbosacral points are to be avoided (TCMPB advisory 2021, §4.1.4).",
        "The rule is about the region: a tender Ashi point in the lumbar muscles is a lumbosacral point.",
        "No prone positioning in mid-pregnancy; LI4 and SP6 are traditionally avoided."
      ],
      "teachingPoints": [
        "Ask about pregnancy, and its stage, before choosing points.",
        "Antenatal physiotherapy and her obstetric team are the main route for pregnancy-related back pain."
      ]
    }
  },
