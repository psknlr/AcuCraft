  {
    "requestId": "hs-029",
    "actor": "practitioner",
    "patient": "patient",
    "action": {
      "type": "explain",
      "topics": [
        "procedure",
        "benefits",
        "risks",
        "alternatives",
        "evidence",
        "right-to-stop"
      ],
      "text": "I suggest acupuncture: six fine single-use sterile needles — at the base of the skull, on the tops of the shoulders and in the hands — for about twenty minutes. For frequent tension-type headaches NICE suggests considering a course of up to ten sessions over five to eight weeks. Risks are small: soreness, bruising, feeling faint; around the neck and shoulders I keep the needles shallow because the lung and blood vessels lie deeper. Other options are regular exercise, sleep and screen breaks, and seeing your doctor about how often you take painkillers. You can tell me to stop at any time."
    }
  },
