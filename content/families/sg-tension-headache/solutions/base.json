          }
        ],
        "technique": {
          "method": "manual-filiform",
          "stimulation": "even",
          "retentionMinutes": 20
        },
        "rationale": "GB20 and GB21 for the neck and shoulder tension; LI4 as a distal point for headache.",
        "alternatives": [
          "Exercise, sleep and screen breaks",
          "A medication review with her doctor (analgesic use about 10 days a month)"
        ],
        "followUp": "Weekly for up to ten sessions; review after four."
      }
