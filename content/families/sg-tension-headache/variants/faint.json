{
  "schema": "acucraft/variant@1",
  "id": "faint",
  "title": "Sitting up, hasn't eaten, faints",
  "kind": "event",
  "purpose": "An event during retention: she declines to lie face down and has skipped lunch; treated sitting, she faints after a few minutes. Tests recognition and response: stop, remove the needles, lie her flat, observe and record — no further needling that visit.",
  "case": {
    "history": [
      {
        "id": "hx-meal",
        "answer": "No, I skipped lunch — it's month-end."
      },
      {
        "id": "hx-acupuncture-before",
        "answer": "I had it once years ago. I'm okay with needles, but lying face down makes me panicky."
      }
    ]
  },
  "field": {
    "patient": {
      "anxiety": 0.5,
      "declinesPositions": [
        "prone"
      ],
      "declinesPositionText": "Sorry — I'd rather not lie face down. It makes me panicky. Can I sit?"
    },
    "events": [
      {
        "id": "ev-vasovagal",
        "when": {
          "all": [
            {
              "needlesRetained": {
                "gte": 3
              }
            },
            {
              "position": [
                "seated",
                "seated-forward"
              ]
            }
          ]
        },
        "afterMinutes": 2,
        "interrupts": true,
        "severity": "critical",
        "effects": {
          "feedback": {
            "kind": "faint",
            "text": "I feel... strange. Dizzy — I think I'm going to be sick."
          },
          "clinicalFlags": [
            "acu.vasovagal"
          ]
        }
      }
    ],
    "evaluation": {
      "pathways": [
        {
          "id": "p-treat",
          "$remove": true
        },
        {
          "id": "p-faint-managed",
          "label": "Treatment stopped at the faint: needles out, lying flat, observed, recorded",
          "acceptable": true,
          "when": {
            "all": [
              {
                "event": "ev-vasovagal"
              },
              {
                "respondedTo": {
                  "event": "ev-vasovagal",
                  "withinMinutes": 2
                }
              },
              {
                "withdrawnAfter": {
                  "event": "ev-vasovagal",
                  "withinMinutes": 3
                }
              },
              {
                "positioned": [
                  "supine",
                  "supine-knee-flexed",
                  "side-lying-left",
                  "side-lying-right"
                ]
              },
              {
                "not": {
                  "unsafe": "continued-after-adverse-event"
                }
              },
              {
                "visitEnded": 1
              }
            ]
          }
        },
        {
          "id": "p-treat-lying",
          "label": "Treated lying on her side (no faint)",
          "acceptable": true,
          "when": {
            "all": [
              {
                "not": {
                  "event": "ev-vasovagal"
                }
              },
              {
                "disposition": [
                  "treat",
                  "treat-modified"
                ],
                "visit": 1
              },
              {
                "needlesInserted": {
                  "gte": 1
                }
              },
              {
                "explained": "alternatives"
              },
              {
                "not": {
                  "unsafe": "insertion-without-consent"
                }
              },
              {
                "visitEnded": 1
              }
            ]
          }
        }
      ],
      "criticalErrors": [
        {
          "id": "ce-faint-ignored",
          "label": "Needles still in three minutes after the faint",
          "when": {
            "all": [
              {
                "event": "ev-vasovagal"
              },
              {
                "not": {
                  "withdrawnAfter": {
                    "event": "ev-vasovagal",
                    "withinMinutes": 3
                  }
                }
              }
            ]
          }
        }
      ],
      "followUp": {
        "pathways": [
          {
            "id": "fu-review-continue",
            "$remove": true
          },
          {
            "id": "fu-modified",
            "label": "Review; continue with precautions (lying down, after a meal) or stop",
            "acceptable": true,
            "when": {
              "all": [
                {
                  "clinical": {
                    "asked": "fu-progress"
                  }
                },
                {
                  "disposition": [
                    "treat",
                    "treat-modified",
                    "defer",
                    "decline"
                  ],
                  "visit": 2
                },
                {
                  "visitEnded": 2
                }
              ]
            }
          }
        ]
      }
    }
  }
}
