          "retentionMinutes": 20
        },
        "rationale": "PC6 and ST36 for nausea from spleen–stomach deficiency with rebellious stomach qi, as an adjunct to antiemetics.",
        "alternatives": [
          "Acupressure wristband at PC6",
          "Small, frequent meals",
          "Antiemetic review with her oncologist"
        ],
        "followUp": "After the next cycle."
      }
