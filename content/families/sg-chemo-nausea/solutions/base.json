  {
    "requestId": "cb-028",
    "actor": "practitioner",
    "patient": "patient",
    "action": {
      "type": "explain",
      "topics": [
        "procedure",
        "benefits",
        "risks",
        "alternatives",
        "right-to-stop"
      ],
      "text": "I suggest acupuncture alongside — not instead of — your anti-sickness medicines: four fine single-use sterile needles, at the inner wrist and below the knee on each side, for about twenty minutes. Your blood count is satisfactory and your oncologist is supportive. Risks are small: soreness, bruising, feeling faint, and a small risk of infection, which is why we check your counts. Alternatives are an acupressure wristband at the same wrist point, small frequent meals, and telling your oncologist if the medicines aren't working. You can tell me to stop at any time."
    }
  },
