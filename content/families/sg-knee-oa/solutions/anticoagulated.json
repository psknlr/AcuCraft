          "stimulation": "even",
          "retentionMinutes": 20
        },
        "rationale": "Fewer, shallower points away from the varicose veins because she is anticoagulated.",
        "alternatives": [
          "Exercise therapy and weight management (first line)",
          "Physiotherapy",
          "Pain relief through her doctor"
        ],
        "followUp": "Review in one week."
      }
