{
  "schema": "acucraft/region@1",
  "id": "scalp",
  "version": "0.1.0",
  "title": "scalp",
  "laterality": "midline",
  "chart": {
    "description": "The scalp over the vault, from the anterior to the posterior hairline, unrolled. u: distance (cm) along the transverse arc from the median line, positive towards the patient's LEFT. v: distance (cm) along the median sagittal arc from the anterior hairline, positive backwards over the vertex, so a 'cranial' offset here points away from the forehead (the direction of 'superior to the anterior hairline'); points measured from the posterior hairline are constructed along the line towards the anterior hairline. d: depth below the skin (cm). The anterior hairline is idealised as a transverse line through its median point; the corners of the forehead lie just behind it.",
    "uRange": [
      -10,
      10
    ],
    "vRange": [
      -2,
      30
    ]
  },
  "reference": {
    "heightCm": 170,
    "bmi": 22.5
  },
  "configurations": [
    {
      "id": "neutral",
      "label": "head supported; the scalp reached from above or behind"
    }
  ],
  "defaultConfiguration": "neutral",
