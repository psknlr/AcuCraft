  "landmarks": [
    {
      "id": "anterior-hairline",
      "label": "anterior hairline on the median line",
      "at": {
        "u": 0,
        "v": 0
      },
      "palpation": "Inspect where the skin of the forehead meets the hair on the median line. With a receded or indistinct hairline the standard takes it 3 B-cun above the glabella."
    },
    {
      "id": "anterior-hairline-brow-medial-left",
      "label": "anterior hairline directly above the medial end of the eyebrow (left)",
      "at": {
        "u": 1.15,
        "v": 0
      },
      "palpation": "Follow the vertical line up from the medial end of the eyebrow (the frontal notch) to the anterior hairline."
    },
    {
