      "id": "frontal-hairline-corner-left",
      "label": "corner of the forehead at the anterior hairline (left)",
      "at": {
        "u": 7.2,
        "v": 0.5
      },
      "palpation": "Inspect where the frontal hairline turns down into the temporal hairline; the temporalis moves under it when the teeth are clenched."
    },
    {
      "id": "frontal-hairline-corner-right",
      "label": "corner of the forehead at the anterior hairline (right)",
      "at": {
        "u": -7.2,
        "v": 0.5
      },
      "palpation": "Inspect where the frontal hairline turns down into the temporal hairline; the temporalis moves under it when the teeth are clenched."
