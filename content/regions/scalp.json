    {
      "id": "external-occipital-protuberance",
      "label": "external occipital protuberance",
      "at": {
        "u": 0,
        "v": 23.6
      },
      "palpation": "The bony prominence at the back of the head on the median line."
    },
    {
      "id": "posterior-hairline",
      "label": "posterior hairline on the median line",
      "at": {
        "u": 0,
        "v": 27.6
      },
      "palpation": "Inspect the lower margin of the hair at the nape, on the median line. With an indistinct hairline the standard takes it 3 B-cun above the spinous process of C7."
    }
