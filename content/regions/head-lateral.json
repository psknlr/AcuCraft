{
  "schema": "acucraft/region@1",
  "id": "head-lateral",
  "version": "0.1.0",
  "title": "side of the head",
  "laterality": "bilateral",
  "chart": {
    "description": "The side of the head, unrolled round the head and seen from the side: the temple, the region in front of and above the ear, behind the ear over the mastoid, and the cheek over the masseter down to the angle of the mandible. u: horizontal distance (cm) along the skin from the anterior border of the tragus, positive POSTERIOR (towards the occiput), negative anterior (towards the face). As on the leg chart, 'lateral' means further round from the front: a 'lateral' offset on this chart points backwards and a 'medial' offset forwards, towards the face. v: distance (cm) cranial from the level of the centre of the tragus. d: depth below the skin (cm). The chart is mirrored for the two sides; its anterior edge reaches the median line of the forehead, where the glabella and the anterior hairline give the head's B-cun. The auricle is folded forward to reach the points behind it; of the auricle itself only its apex is modelled. The jaw is shown closed: the points found with the mouth open (GB2, SI19, TE21) are marked in the depressions that open in front of the tragus.",
    "uRange": [
      -16,
      7
    ],
    "vRange": [
      -9,
      11
    ]
  },
  "reference": {
    "heightCm": 170,
    "bmi": 22.5
  },
  "configurations": [
    {
      "id": "neutral",
      "label": "head supported in the neutral position, face relaxed, eyes looking straight ahead, mouth closed"
    }
  ],
  "defaultConfiguration": "neutral",
  "access": [
    {
      "position": "seated",
      "configuration": "neutral",
      "sides": [
        "left",
        "right"
      ]
    },
