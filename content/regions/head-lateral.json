        "right"
      ]
    },
    {
      "position": "side-lying-right",
      "configuration": "neutral",
      "sides": [
        "left"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "tragus",
      "label": "tragus (anterior border at its centre)",
      "at": {
        "u": 0,
        "v": 0
      },
      "palpation": "Inspect and palpate the small flap in front of the ear canal; the reference is the middle of its anterior border."
    },
    {
      "id": "supratragic-notch",
      "label": "supratragic notch",
      "at": {
        "u": 0.15,
        "v": 0.85
      },
      "palpation": "The small notch between the upper end of the tragus and the root of the helix."
    },
    {
      "id": "intertragic-notch",
      "label": "intertragic notch",
      "at": {
        "u": 0.25,
        "v": -0.9
      },
      "palpation": "The notch between the lower end of the tragus and the antitragus."
    },
    {
      "id": "condyle",
      "label": "condylar process (head) of the mandible",
      "at": {
        "u": -1.3,
        "v": -0.2
      },
      "palpation": "Palpate just in front of the tragus while the patient opens and closes the mouth: the condyle glides forward on opening and leaves a depression behind it."
    },
    {
      "id": "zygomatic-arch-midpoint",
      "label": "midpoint of the zygomatic arch",
      "at": {
        "u": -3.0,
        "v": 0.1
      },
      "palpation": "Follow the bony bar of the arch from the cheekbone back to the front of the ear and take its midpoint."
    },
    {
      "id": "mandibular-notch",
      "label": "mandibular notch (below the zygomatic arch)",
      "at": {
        "u": -2.9,
        "v": -1.3
      },
      "palpation": "With the mouth closed, the depression below the zygomatic arch between the coronoid process and the condyle; it fills when the mouth opens."
    },
    {
      "id": "mandibular-angle",
      "label": "angle of the mandible",
      "at": {
        "u": -0.9,
        "v": -5.8
      },
      "palpation": "Palpate the corner of the jaw below and in front of the ear lobe."
    },
    {
      "id": "masseter-anterior-border",
      "label": "anterior border of the masseter at the lower border of the mandible",
      "at": {
        "u": -3.55,
        "v": -6.35
      },
      "palpation": "Ask the patient to clench the teeth and feel the front edge of the masseter where it meets the lower border of the jaw; the facial artery pulse is felt just in front of it."
    },
    {
      "id": "earlobe-depression",
      "label": "depression behind the ear lobe",
      "at": {
        "u": 1.2,
        "v": -3.0
      },
      "palpation": "Behind the ear lobe, the depression between the mastoid process and the ramus of the mandible."
    },
    {
      "id": "mastoid-tip",
      "label": "tip of the mastoid process",
      "at": {
        "u": 2.8,
        "v": -3.3
      },
      "palpation": "Palpate the bony prominence behind the ear lobe and follow it down to its tip."
    },
    {
      "id": "mastoid-posteroinferior-depression",
      "label": "depression posteroinferior to the mastoid process",
      "at": {
        "u": 3.9,
        "v": -3.6
      },
      "palpation": "Behind and below the mastoid process, the depression at the upper end of the posterior border of sternocleidomastoid."
    },
    {
      "id": "auricular-root-anterior",
      "label": "anterior (upper) root of the auricle",
      "at": {
        "u": 0.4,
        "v": 1.6
      },
      "palpation": "Where the front of the auricle (the root of the helix) joins the side of the head, above the tragus."
    },
    {
      "id": "auricular-root-posterior",
      "label": "posterior border of the auricular root (upper part)",
      "at": {
        "u": 2.6,
        "v": 2.6
      },
      "palpation": "Fold the auricle forward: the upper part of the line where the back of the auricle joins the scalp."
    },
    {
      "id": "auricular-apex",
      "label": "apex of the auricle",
      "at": {
        "u": 1.6,
        "v": 3.6
      },
      "palpation": "Fold the auricle forward: its highest point."
    },
    {
      "id": "temporal-hairline-posterior",
      "label": "posterior border of the temple hairline, at the level of the auricular apex",
      "at": {
        "u": -0.8,
        "v": 3.6
      },
      "palpation": "Follow the posterior edge of the temple (sideburn) hair upwards in front of the ear to the horizontal line through the auricular apex."
    },
    {
      "id": "frontal-hairline-corner",
      "label": "corner of the forehead at the anterior hairline",
      "at": {
        "u": -7.6,
        "v": 8.4
      },
      "palpation": "Inspect where the frontal hairline turns down into the temporal hairline; the temporalis moves under it when the teeth are clenched."
    },
    {
      "id": "glabella",
      "label": "glabella",
      "at": {
        "u": -15.0,
        "v": 3.5
      },
      "palpation": "The smooth bony prominence between the eyebrows, above the root of the nose."
    },
    {
      "id": "anterior-hairline",
      "label": "anterior hairline on the median line",
      "at": {
        "u": -15.0,
        "v": 9.8
      },
      "palpation": "Inspect where the skin of the forehead meets the hair on the median line; with a receded hairline the standard takes it 3 B-cun above the glabella."
    }
  ],
  "segments": [
    {
      "id": "seg.glabella-hairline",
      "label": "glabella to the anterior hairline (the head's B-cun, used on the side of the head)",
      "from": "glabella",
      "to": "anterior-hairline",
      "cun": 3,
      "source": {
        "title": "WHO Standard Acupuncture Point Locations (2008): proportional bone measurement",
        "verified": false
      }
    }
  ],
