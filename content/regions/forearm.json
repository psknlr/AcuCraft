{
  "schema": "acucraft/region@1",
  "id": "forearm",
  "version": "0.2.0",
  "title": "forearm, wrist and elbow (all aspects)",
  "laterality": "bilateral",
  "chart": {
    "description": "The forearm unrolled. u: distance round the forearm (cm) from the palmar midline, positive towards the radial (lateral) side and on round to the dorsum (dorsal midline at about +8.5 at the wrist, the olecranon at about +13.7 at the elbow) and the posterior border of the ulna; negative towards the ulnar side of the palmar surface. The two ends of the chart meet on the ulnar border. v: distance (cm) proximal from the palmar wrist crease (the cubital crease lies at about v = 26.4). d: depth below the skin (cm). Beyond the dorsal midline 'lateral' (+u) points towards the ulnar side of the dorsum.",
    "uRange": [
      -8,
      18
    ],
    "vRange": [
      -4,
      31
    ]
  },
  "configurations": [
    {
      "id": "supinated",
      "label": "forearm supinated, palm up, supported"
    },
    {
      "id": "pronated",
      "label": "forearm pronated, palm down, resting on a table or pillow (seated leaning forward)"
    }
  ],
  "defaultConfiguration": "supinated",
  "access": [
    {
      "position": "seated",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine-knee-flexed",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "side-lying-left",
      "configuration": "supinated",
      "sides": [
        "right"
      ]
    },
    {
      "position": "side-lying-right",
      "configuration": "supinated",
      "sides": [
        "left"
      ]
    },
    {
      "position": "seated-forward",
      "configuration": "pronated",
      "sides": [
        "left",
        "right"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "wrist-crease-mid",
      "label": "midpoint of the palmar wrist crease",
      "at": {
        "u": 0,
        "v": 0
      }
    },
    {
      "id": "pl-fcr-wrist",
      "label": "between the palmaris longus and flexor carpi radialis tendons at the palmar wrist crease",
      "at": {
        "u": 0.5,
        "v": 0
      },
      "palpation": "Flex the wrist against resistance: the two most prominent tendons; the point lies between them."
    },
    {
      "id": "cubital-crease-mid",
      "label": "midpoint of the cubital crease",
      "at": {
        "u": 0.4,
        "v": 26.4
      }
    },
    {
      "id": "fcu-radial-wrist",
      "label": "radial border of the flexor carpi ulnaris tendon at the palmar wrist crease",
      "at": {
        "u": -3.0,
        "v": 0
      },
      "palpation": "Just proximal to the pisiform, on the radial side of the tendon."
    },
    {
      "id": "apl-groove-wrist",
      "label": "groove of the abductor pollicis longus tendon on the radial aspect, at the level of the wrist crease",
      "at": {
        "u": 4.3,
        "v": 0
      }
    },
    {
      "id": "radial-border-elbow",
      "label": "radial end of the cubital crease",
      "at": {
        "u": 4.6,
        "v": 26.0
      }
    },
    {
      "id": "radial-styloid",
      "label": "radial styloid process",
      "at": {
        "u": 4.5,
        "v": 0.5
      },
      "palpation": "The bony point on the lateral side of the wrist at the end of the radius, at about the level of the wrist crease."
    },
    {
      "id": "radial-styloid-scaphoid-depression",
      "label": "depression on the palmar wrist crease between the radial styloid process and the scaphoid, ulnar to the abductor pollicis longus tendon",
      "at": {
        "u": 2.75,
        "v": 0.0
      },
      "palpation": "Feel the radial pulse at the wrist crease; the hollow just radial to it, between the end of the radius and the scaphoid, on the ulnar side of the abductor pollicis longus tendon."
    },
    {
      "id": "anatomical-snuffbox",
      "label": "anatomical snuffbox, at the radial end of the dorsal wrist crease",
      "at": {
        "u": 5.9,
        "v": -0.6
      },
      "palpation": "Extend the thumb: the hollow at the back of the wrist at the base of the thumb, between the extensor pollicis longus and brevis tendons, just distal to the radial styloid."
    },
    {
      "id": "lister-tubercle",
      "label": "dorsal tubercle of the radius (Lister's tubercle)",
      "at": {
        "u": 7.3,
        "v": 1.2
      },
      "palpation": "The small bony ridge on the back of the distal radius, in line with the cleft between the index and middle fingers."
    },
    {
      "id": "dorsal-wrist-crease-mid",
      "label": "midpoint of the dorsal wrist crease",
      "at": {
        "u": 8.45,
        "v": 0.3
      },
      "palpation": "Extend the wrist slightly: the crease across the back of the wrist; its middle, over the extensor tendons."
    },
    {
      "id": "edc-radial-wrist",
      "label": "depression on the dorsal wrist crease radial to the extensor digitorum tendons",
      "at": {
        "u": 7.7,
        "v": 0.3
      },
      "palpation": "Extend the fingers against resistance to raise the tendons; slide off their radial edge on the crease."
    },
    {
      "id": "edc-ulnar-wrist",
      "label": "depression on the dorsal wrist crease ulnar to the extensor digitorum tendons",
      "at": {
        "u": 9.5,
        "v": 0.3
      },
      "palpation": "Extend the fingers against resistance; slide off the ulnar edge of the tendons on the crease."
    },
    {
      "id": "ulnar-head",
      "label": "head of the ulna (its dorsal prominence)",
      "at": {
        "u": 11.0,
        "v": 2.2
      },
      "palpation": "The rounded knob at the back of the wrist on the little-finger side, most prominent with the forearm pronated.",
      "configurations": {
        "pronated": {
          "du": -0.4,
          "dv": 0,
          "dd": 0
        }
      }
    },
    {
      "id": "ulnar-styloid",
      "label": "ulnar styloid process",
      "at": {
        "u": 12.0,
        "v": 0.3
      },
      "palpation": "Distal to the head of the ulna, the small bony point at the back of the wrist on the little-finger side.",
      "configurations": {
        "pronated": {
          "du": -0.3,
          "dv": 0,
          "dd": 0
        }
      }
    },
    {
      "id": "triquetrum",
      "label": "triquetrum",
      "at": {
        "u": 12.5,
        "v": -1.3
      },
      "palpation": "Just distal to the ulnar styloid, the carpal bone felt on the ulnar side of the back of the wrist, clearer with the wrist deviated radially."
    },
    {
      "id": "biceps-tendon-lateral-crease",
      "label": "depression on the cubital crease just lateral to the biceps brachii tendon",
      "at": {
        "u": 2.1,
        "v": 26.4
      },
      "palpation": "Raise the biceps tendon, then slide off its lateral edge into the hollow on the crease."
    },
    {
      "id": "cubital-crease-medial-end",
      "label": "medial (ulnar) end of the cubital crease",
      "at": {
        "u": -4.6,
        "v": 26.2
      },
      "palpation": "Flex the elbow: the end of the crease on the little-finger side."
    },
    {
      "id": "lateral-epicondyle",
      "label": "lateral epicondyle of the humerus",
      "at": {
        "u": 7.0,
        "v": 26.8
      },
      "palpation": "The bony prominence on the outer side of the elbow."
    },
    {
      "id": "medial-epicondyle",
      "label": "medial epicondyle of the humerus",
      "at": {
        "u": -6.2,
        "v": 27.2
      },
      "palpation": "The prominent bony knob on the inner side of the elbow."
    },
    {
      "id": "olecranon",
      "label": "tip of the olecranon (the point of the elbow)",
      "at": {
        "u": 13.65,
        "v": 27.0
      },
      "palpation": "The bony point of the elbow, at the upper end of the subcutaneous border of the ulna."
    }
  ],
  "segments": [
    {
      "id": "seg.wrist-elbow",
      "label": "palmar wrist crease to cubital crease",
      "from": "wrist-crease-mid",
      "to": "cubital-crease-mid",
      "cun": 12,
      "source": {
        "title": "WHO Standard Acupuncture Point Locations (2008): proportional bone measurement",
        "verified": false
      }
    },
    {
      "id": "seg.forearm-dorsal",
      "label": "dorsal wrist crease to the prominence of the olecranon",
      "from": "dorsal-wrist-crease-mid",
      "to": "olecranon",
      "cun": 12,
      "source": {
        "title": "WHO Standard Acupuncture Point Locations (2008): proportional bone measurement, upper limb",
        "verified": false,
        "note": "Used for the points measured from the dorsal wrist crease or from the olecranon (triple energizer and small intestine channels)."
      }
    }
  ],
