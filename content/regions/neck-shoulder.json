{
  "schema": "acucraft/region@1",
  "id": "neck-shoulder",
  "version": "0.2.0",
  "title": "posterior neck and shoulders",
  "laterality": "midline",
  "chart": {
    "description": "The back of the neck and the tops of the shoulders, seen from behind. u: distance (cm) from the posterior midline, positive towards the patient's LEFT. v: distance (cm) cranial from the tip of the C7 spinous process. d: depth below the skin (cm). The chart reaches up over the occiput to just above the external occipital protuberance, and wraps round the side of the upper neck to the depression behind the ear lobe.",
    "uRange": [
      -20,
      20
    ],
    "vRange": [
      -10,
      19
    ]
  },
  "configurations": [
    {
      "id": "prone",
      "label": "prone, forehead supported"
    },
    {
      "id": "seated-forward",
      "label": "seated, leaning forward with the head flexed"
    }
  ],
  "defaultConfiguration": "prone",
  "access": [
    {
      "position": "prone",
      "configuration": "prone",
      "sides": [
        "left",
        "right",
        "midline"
      ]
    },
    {
      "position": "seated-forward",
      "configuration": "seated-forward",
      "sides": [
        "left",
        "right",
        "midline"
      ]
    },
    {
