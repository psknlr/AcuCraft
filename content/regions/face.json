    },
    {
      "id": "upper-lip-tubercle",
      "label": "tubercle of the upper lip",
      "at": {
        "u": 0,
        "v": -8.15
      },
      "palpation": "Inspect the small central prominence of the red part of the upper lip."
    },
    {
      "id": "mouth-angle-left",
      "label": "angle of the mouth (left)",
      "at": {
        "u": 2.5,
        "v": -8.5
      },
      "palpation": "Inspect the corner of the closed mouth, where the lips meet."
    },
    {
      "id": "mouth-angle-right",
      "label": "angle of the mouth (right)",
      "at": {
        "u": -2.5,
        "v": -8.5
      },
      "palpation": "Inspect the corner of the closed mouth, where the lips meet."
    },
    {
      "id": "mentolabial-sulcus",
      "label": "centre of the mentolabial sulcus",
      "at": {
        "u": 0,
        "v": -10.6
      },
      "palpation": "Inspect the transverse groove between the lower lip and the chin, on the median line."
    },
    {
      "id": "chin",
      "label": "lowest point of the chin (menton)",
      "at": {
        "u": 0,
        "v": -13.0
      },
      "palpation": "Palpate the lowest point of the bony chin."
    }
