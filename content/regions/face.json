      "at": {
        "u": 1.05,
        "v": -6.0
      },
      "palpation": "Inspect the outer margin of the nostril opening from the front."
    },
    {
      "id": "nostril-lateral-right",
      "label": "lateral margin of the nostril (right)",
      "at": {
        "u": -1.05,
        "v": -6.0
      },
      "palpation": "Inspect the outer margin of the nostril opening from the front."
    },
    {
      "id": "nose-tip",
      "label": "tip of the nose",
      "at": {
        "u": 0,
        "v": -5.2
      },
      "palpation": "Inspect the most prominent point of the nasal tip."
    },
    {
      "id": "subnasale",
      "label": "subnasale (upper end of the philtrum)",
      "at": {
        "u": 0,
        "v": -6.3
      },
      "palpation": "Inspect where the base of the nasal septum meets the upper lip."
    },
    {
      "id": "philtrum-lower",
      "label": "lower end of the philtrum, at the vermilion border",
      "at": {
        "u": 0,
        "v": -7.9
      },
