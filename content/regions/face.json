{
  "schema": "acucraft/region@1",
  "id": "face",
  "version": "0.1.0",
  "title": "face",
  "laterality": "midline",
  "chart": {
    "description": "The face from the chin to the anterior hairline, seen from the front: the forehead and eyebrows, the eyes and orbits, the nose, the cheeks, the lips and chin, and the front of the temples. u: distance (cm) across the skin from the anterior median line, positive towards the patient's LEFT (lateral runs from the median line out towards the temple). v: distance (cm) cranial from the glabella. d: depth below the skin (cm).",
    "uRange": [
      -9,
      9
    ],
    "vRange": [
      -14,
      8
    ]
  },
  "reference": {
    "heightCm": 170,
    "bmi": 22.5
  },
  "configurations": [
    {
      "id": "neutral",
      "label": "head supported in the neutral position, face relaxed, eyes looking straight ahead, mouth closed"
    }
  ],
  "defaultConfiguration": "neutral",
  "access": [
    {
      "position": "supine",
      "configuration": "neutral",
      "sides": [
        "left",
        "right",
        "midline"
      ]
    },
    {
      "position": "supine-knee-flexed",
      "configuration": "neutral",
      "sides": [
        "left",
        "right",
        "midline"
      ]
    },
    {
      "position": "seated",
      "configuration": "neutral",
      "sides": [
        "left",
        "right",
        "midline"
      ]
    },
    {
      "position": "side-lying-left",
      "configuration": "neutral",
      "sides": [
        "right",
        "midline"
      ]
    },
    {
      "position": "side-lying-right",
      "configuration": "neutral",
      "sides": [
        "left",
        "midline"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "glabella",
      "label": "glabella",
      "at": {
        "u": 0,
        "v": 0
      },
      "palpation": "The smooth bony prominence between the eyebrows, above the root of the nose."
    },
    {
      "id": "anterior-hairline",
      "label": "anterior hairline on the median line",
      "at": {
        "u": 0,
        "v": 6.3
      },
      "palpation": "Inspect where the skin of the forehead meets the hair on the median line; frown lines and fine hairs help. With a receded or indistinct hairline the standard takes it 3 B-cun above the glabella."
    },
    {
      "id": "eyebrow-medial-left",
      "label": "medial end of the eyebrow (left)",
      "at": {
        "u": 1.15,
        "v": 0.2
      },
      "palpation": "Inspect the medial end of the eyebrow; a small notch (the supratrochlear or frontal notch) is felt in the orbital margin beneath it."
    },
    {
      "id": "eyebrow-medial-right",
      "label": "medial end of the eyebrow (right)",
      "at": {
        "u": -1.15,
        "v": 0.2
      },
      "palpation": "Inspect the medial end of the eyebrow; a small notch (the supratrochlear or frontal notch) is felt in the orbital margin beneath it."
    },
    {
      "id": "eyebrow-middle-left",
      "label": "middle of the eyebrow, directly above the pupil (left)",
      "at": {
        "u": 3.15,
        "v": 0.8
      },
      "palpation": "With the eyes looking straight ahead, follow the vertical line through the pupil up to the eyebrow."
    },
    {
      "id": "eyebrow-middle-right",
      "label": "middle of the eyebrow, directly above the pupil (right)",
      "at": {
        "u": -3.15,
        "v": 0.8
      },
      "palpation": "With the eyes looking straight ahead, follow the vertical line through the pupil up to the eyebrow."
    },
    {
      "id": "eyebrow-lateral-left",
      "label": "lateral end of the eyebrow (left)",
      "at": {
        "u": 5.3,
        "v": 0.3
      },
      "palpation": "Inspect the lateral end of the eyebrow; a small depression lies over the zygomatic process of the frontal bone."
    },
    {
      "id": "eyebrow-lateral-right",
      "label": "lateral end of the eyebrow (right)",
      "at": {
        "u": -5.3,
        "v": 0.3
      },
      "palpation": "Inspect the lateral end of the eyebrow; a small depression lies over the zygomatic process of the frontal bone."
    },
    {
      "id": "canthus-inner-left",
      "label": "inner canthus (left)",
      "at": {
        "u": 1.6,
        "v": -1.9
      },
      "palpation": "Inspect the medial angle of the eye, where the eyelids meet beside the nose."
    },
    {
      "id": "canthus-inner-right",
      "label": "inner canthus (right)",
      "at": {
        "u": -1.6,
        "v": -1.9
      },
      "palpation": "Inspect the medial angle of the eye, where the eyelids meet beside the nose."
    },
    {
      "id": "canthus-outer-left",
      "label": "outer canthus (left)",
      "at": {
        "u": 4.75,
        "v": -1.7
      },
      "palpation": "Inspect the lateral angle of the eye, where the eyelids meet."
    },
    {
      "id": "canthus-outer-right",
      "label": "outer canthus (right)",
      "at": {
        "u": -4.75,
        "v": -1.7
      },
      "palpation": "Inspect the lateral angle of the eye, where the eyelids meet."
    },
    {
      "id": "pupil-left",
      "label": "centre of the pupil (eyes looking straight ahead) (left)",
      "at": {
        "u": 3.15,
        "v": -2.0
      },
      "palpation": "Ask the patient to look straight ahead and inspect the centre of the pupil."
    },
    {
      "id": "pupil-right",
      "label": "centre of the pupil (eyes looking straight ahead) (right)",
      "at": {
        "u": -3.15,
        "v": -2.0
      },
      "palpation": "Ask the patient to look straight ahead and inspect the centre of the pupil."
    },
    {
      "id": "infraorbital-margin-medial-left",
      "label": "medial end of the infraorbital margin (left)",
      "at": {
        "u": 1.7,
        "v": -3.2
      },
      "palpation": "Follow the lower rim of the orbit medially to where it turns up into the anterior lacrimal crest beside the nose."
    },
    {
      "id": "infraorbital-margin-medial-right",
      "label": "medial end of the infraorbital margin (right)",
      "at": {
        "u": -1.7,
        "v": -3.2
      },
      "palpation": "Follow the lower rim of the orbit medially to where it turns up into the anterior lacrimal crest beside the nose."
    },
    {
      "id": "infraorbital-margin-pupil-left",
      "label": "infraorbital margin directly below the pupil (left)",
      "at": {
        "u": 3.15,
        "v": -3.7
      },
      "palpation": "Palpate the bony lower rim of the orbit through the lower eyelid, on the vertical line through the pupil."
    },
    {
      "id": "infraorbital-margin-pupil-right",
      "label": "infraorbital margin directly below the pupil (right)",
      "at": {
        "u": -3.15,
        "v": -3.7
      },
      "palpation": "Palpate the bony lower rim of the orbit through the lower eyelid, on the vertical line through the pupil."
    },
    {
      "id": "infraorbital-margin-lateral-left",
      "label": "lateral end of the infraorbital margin (left)",
      "at": {
        "u": 5.1,
        "v": -2.9
      },
      "palpation": "Follow the lower rim of the orbit laterally to where it turns up into the lateral orbital margin (zygomatic bone)."
    },
    {
      "id": "infraorbital-margin-lateral-right",
      "label": "lateral end of the infraorbital margin (right)",
      "at": {
        "u": -5.1,
        "v": -2.9
      },
      "palpation": "Follow the lower rim of the orbit laterally to where it turns up into the lateral orbital margin (zygomatic bone)."
    },
    {
      "id": "infraorbital-foramen-left",
      "label": "infraorbital foramen (left)",
      "at": {
        "u": 3.0,
        "v": -4.6
      },
      "palpation": "About 1 cm below the infraorbital margin, roughly in line with the pupil: a small depression felt with firm pressure; pressure here is often tender."
    },
    {
      "id": "infraorbital-foramen-right",
      "label": "infraorbital foramen (right)",
      "at": {
        "u": -3.0,
        "v": -4.6
      },
      "palpation": "About 1 cm below the infraorbital margin, roughly in line with the pupil: a small depression felt with firm pressure; pressure here is often tender."
    },
    {
      "id": "zygoma-lower-border-left",
      "label": "lower border of the zygomatic bone, directly below the outer canthus (left)",
      "at": {
        "u": 4.75,
        "v": -5.0
      },
      "palpation": "Follow the vertical line down from the outer canthus to the lower edge of the cheekbone."
    },
    {
      "id": "zygoma-lower-border-right",
      "label": "lower border of the zygomatic bone, directly below the outer canthus (right)",
      "at": {
        "u": -4.75,
        "v": -5.0
      },
      "palpation": "Follow the vertical line down from the outer canthus to the lower edge of the cheekbone."
    },
    {
      "id": "nasal-bone-lower-end-left",
      "label": "lower end of the nasal bone, at its junction with the alar cartilage (left)",
      "at": {
        "u": 1.25,
        "v": -3.9
      },
      "palpation": "Slide a finger down the side of the nose: the firm nasal bone gives way to the mobile cartilage at the upper end of the nasolabial sulcus."
    },
    {
      "id": "nasal-bone-lower-end-right",
      "label": "lower end of the nasal bone, at its junction with the alar cartilage (right)",
      "at": {
        "u": -1.25,
        "v": -3.9
      },
      "palpation": "Slide a finger down the side of the nose: the firm nasal bone gives way to the mobile cartilage at the upper end of the nasolabial sulcus."
    },
    {
      "id": "ala-lateral-left",
      "label": "lateral border of the ala of the nose, at its midpoint (left)",
      "at": {
        "u": 1.75,
        "v": -5.4
      },
      "palpation": "Inspect the outer curve of the nostril wing; the nasolabial sulcus begins just lateral to it."
    },
    {
      "id": "ala-lateral-right",
      "label": "lateral border of the ala of the nose, at its midpoint (right)",
      "at": {
        "u": -1.75,
        "v": -5.4
      },
