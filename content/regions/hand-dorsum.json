{
  "schema": "acucraft/region@1",
  "id": "hand-dorsum",
  "version": "0.2.0",
  "title": "dorsum of the hand, fingers and thumb",
  "laterality": "bilateral",
  "chart": {
    "description": "The back of the hand and of the fingers. u: distance (cm) from the axis of the third metacarpal, positive towards the radial (thumb) side, negative towards the ulnar side. v: distance (cm) proximal from the line of the metacarpophalangeal joints (knuckles); negative along the fingers to the fingertips (the middle fingertip at about -10). The thumb, resting beside the index finger, runs distally and radially from its metacarpophalangeal joint at about (6.4, 2.4). d: depth below the skin (cm).",
    "uRange": [
      -6,
      11
    ],
    "vRange": [
      -11,
      10
    ]
  },
  "configurations": [
    {
      "id": "relaxed",
      "label": "hand relaxed, supported"
    }
  ],
  "defaultConfiguration": "relaxed",
  "access": [
    {
      "position": "seated",
      "configuration": "relaxed",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "seated-forward",
      "configuration": "relaxed",
      "sides": [
        "left",
        "right"
      ]
    },
