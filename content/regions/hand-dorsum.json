      "at": {
        "u": -4.2,
        "v": 0.3
      },
      "palpation": "Make a loose fist: the end of the transverse crease on the ulnar side."
    },
    {
      "id": "wrist-dorsal-crease",
      "label": "dorsal wrist crease",
      "at": {
        "u": 0,
        "v": 8.0
      }
    },
    {
      "id": "mc3-head",
      "label": "head of the third metacarpal (the middle knuckle)",
      "at": {
        "u": 0.0,
        "v": 0.0
      },
      "palpation": "Make a loose fist: the most prominent knuckle."
    },
    {
      "id": "mc4-head",
      "label": "head of the fourth metacarpal (the ring knuckle)",
      "at": {
        "u": -1.8,
        "v": 0.1
      }
    },
    {
      "id": "mc5-head",
      "label": "head of the fifth metacarpal (the little-finger knuckle)",
      "at": {
        "u": -3.6,
        "v": 0.3
      }
    },
    {
      "id": "cleft-2-3",
      "label": "depression between the heads of the second and third metacarpals",
      "at": {
        "u": 0.8,
        "v": 0.5
      },
      "palpation": "Between the index and middle knuckles, just proximal to them."
    },
    {
      "id": "cleft-4-5",
      "label": "depression between the heads of the fourth and fifth metacarpals",
      "at": {
        "u": -2.75,
        "v": 0.6
      },
      "palpation": "Between the ring and little-finger knuckles, just proximal to them."
    },
    {
      "id": "web-4-5",
      "label": "margin of the web between the ring and little fingers",
      "at": {
        "u": -2.8,
        "v": -1.9
      },
      "palpation": "With the fingers slightly spread, the free edge of the skin web between the ring and little fingers."
    },
    {
      "id": "mc5-base",
      "label": "base of the fifth metacarpal (ulnar border)",
      "at": {
        "u": -4.3,
        "v": 6.4
      },
      "palpation": "Run a finger proximally along the ulnar border of the fifth metacarpal to the prominence at its base."
    },
    {
      "id": "triquetrum",
      "label": "triquetrum, on the ulnar border of the wrist",
      "at": {
        "u": -4.4,
        "v": 7.9
      },
      "palpation": "Proximal to the base of the fifth metacarpal and distal to the ulnar styloid; clearer with the wrist deviated radially."
    },
    {
      "id": "mcp-1-dorsal",
      "label": "dorsum of the thumb metacarpophalangeal joint",
      "at": {
        "u": 6.4,
        "v": 2.4
      },
      "palpation": "Flex the thumb at its base: the joint line on the back of the thumb."
    },
    {
      "id": "ip-1-dorsal",
      "label": "centre of the dorsum of the thumb interphalangeal joint",
      "at": {
        "u": 7.4,
        "v": -0.43
      },
      "palpation": "Flex the tip of the thumb: the middle of the joint line on the back of the thumb."
    },
    {
      "id": "pip-3-dorsal",
      "label": "centre of the dorsum of the proximal interphalangeal joint of the middle finger",
      "at": {
        "u": 0.0,
        "v": -5.0
      },
      "palpation": "Flex the finger: the middle of the joint line on the back of the middle finger at its first finger joint."
    },
    {
      "id": "pip-5-dorsal",
      "label": "centre of the dorsum of the proximal interphalangeal joint of the little finger",
      "at": {
        "u": -3.92,
        "v": -3.4
      },
      "palpation": "Flex the finger: the middle of the joint line on the back of the little finger at its first finger joint."
    },
    {
      "id": "nail-1-radial-corner",
      "label": "radial corner of the thumbnail",
      "at": {
        "u": 8.27,
        "v": -0.65
      },
      "palpation": "Where the radial border of the nail meets the line of its base (the proximal nail fold)."
    },
    {
      "id": "nail-2-radial-corner",
      "label": "radial corner of the nail of the index finger",
      "at": {
        "u": 2.8,
        "v": -7.3
      },
      "palpation": "Where the radial border of the nail meets the line of its base."
    },
    {
      "id": "nail-4-ulnar-corner",
