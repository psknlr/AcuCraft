    },
    {
      "position": "side-lying-right",
      "configuration": "relaxed",
      "sides": [
        "left"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "mc2-head",
      "label": "head of the second metacarpal (radial side of the index knuckle)",
