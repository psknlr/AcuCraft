{
  "schema": "acucraft/region@1",
  "id": "upper-arm",
  "version": "0.1.0",
  "title": "shoulder, axilla, arm and elbow",
  "laterality": "bilateral",
  "chart": {
    "description": "The shoulder, arm and elbow unrolled round the limb. u: distance round the limb (cm) from the anterior midline of the arm (over biceps brachii), positive towards lateral (deltoid, lateral epicondyle) and on round the back of the arm (triceps, olecranon at about +13.7) to the posteromedial elbow (ulnar groove at about +18.4); negative towards medial (medial bicipital groove, medial epicondyle, axilla). The two ends of the chart meet on the posteromedial arm. v: distance (cm) along the arm from the level of the cubital crease (v = 0 at its midpoint), positive cranial towards the shoulder; above the lateral border of the acromion (v about 31) v continues over the top of the shoulder towards the base of the neck. d: depth below the skin (cm).",
    "uRange": [
      -12,
      23
    ],
    "vRange": [
      -6,
      41
    ]
  },
  "reference": {
    "heightCm": 170,
    "bmi": 22.5
  },
  "configurations": [
    {
      "id": "arm-at-side",
      "label": "arm by the side, elbow extended (the anatomical position; prone with the arms alongside)"
    },
    {
      "id": "elbow-flexed",
      "label": "arm by the side, elbow flexed to about 90 degrees with the forearm supported (seated or side-lying)"
    },
    {
      "id": "arm-abducted",
      "label": "arm abducted to about 90 degrees and supported, elbow extended, palm up (supine)"
    }
  ],
  "defaultConfiguration": "arm-at-side",
  "access": [
    {
      "position": "seated",
      "configuration": "elbow-flexed",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine",
      "configuration": "arm-abducted",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine-knee-flexed",
      "configuration": "arm-abducted",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "side-lying-left",
      "configuration": "elbow-flexed",
      "sides": [
        "right"
      ]
    },
    {
      "position": "side-lying-right",
      "configuration": "elbow-flexed",
      "sides": [
        "left"
      ]
    },
    {
      "position": "prone",
      "configuration": "arm-at-side",
      "sides": [
        "left",
        "right"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "cubital-crease-mid",
      "label": "midpoint of the cubital crease",
      "at": {
        "u": 0.4,
        "v": 0.0
      },
      "palpation": "The transverse skin crease at the front of the elbow, seen with the elbow slightly flexed; its midpoint."
    },
    {
      "id": "biceps-tendon",
      "label": "biceps brachii tendon at the elbow",
      "at": {
        "u": 1.1,
        "v": 0.3
      },
      "palpation": "Flex the elbow against resistance: the firm cord in the middle of the front of the elbow."
    },
    {
      "id": "biceps-tendon-lateral-crease",
      "label": "depression on the cubital crease just lateral to the biceps brachii tendon",
      "at": {
        "u": 2.1,
        "v": 0.0
      },
      "palpation": "Raise the biceps tendon, then slide off its lateral (radial) edge into the hollow on the crease."
    },
    {
      "id": "biceps-tendon-medial-crease",
      "label": "depression on the cubital crease just medial to the biceps brachii tendon",
      "at": {
        "u": 0.1,
        "v": 0.0
      },
      "palpation": "Slide off the medial (ulnar) edge of the tendon into the hollow on the crease; the brachial pulse is felt just medial and deep to it."
    },
    {
      "id": "cubital-crease-lateral-end",
      "label": "lateral (radial) end of the cubital crease",
      "at": {
        "u": 4.6,
        "v": -0.3
      },
      "palpation": "Flex the elbow fully: the end of the crease on the thumb side."
    },
    {
      "id": "cubital-crease-medial-end",
      "label": "medial (ulnar) end of the cubital crease",
      "at": {
        "u": -4.6,
        "v": -0.2
      },
      "palpation": "Flex the elbow: the end of the crease on the little-finger side, in front of the medial epicondyle."
    },
    {
      "id": "lateral-cubital-depression",
      "label": "depression at the lateral end of the cubital crease, midway between the biceps tendon and the lateral epicondyle",
      "at": {
        "u": 4.55,
        "v": 0.15
      },
      "palpation": "With the elbow flexed to a right angle, the hollow at the lateral end of the crease, half-way from the biceps tendon to the lateral epicondyle."
    },
    {
      "id": "lateral-epicondyle",
      "label": "lateral epicondyle of the humerus",
      "at": {
        "u": 7.0,
        "v": 0.3
      },
      "palpation": "The bony prominence on the outer side of the elbow."
    },
    {
      "id": "medial-epicondyle",
      "label": "medial epicondyle of the humerus",
      "at": {
        "u": -6.2,
        "v": 0.8
      },
      "palpation": "The prominent bony knob on the inner side of the elbow."
    },
    {
      "id": "olecranon",
      "label": "tip of the olecranon (the point of the elbow)",
      "at": {
        "u": 13.65,
        "v": 0.6
      },
      "palpation": "With the elbow straight it lies level with the two epicondyles; flexing the elbow brings it distally, below the line joining them.",
      "configurations": {
        "elbow-flexed": {
          "du": 0,
          "dv": -1.8,
          "dd": 0
        }
      }
    },
    {
      "id": "ulnar-groove",
      "label": "groove between the olecranon and the medial epicondyle (ulnar nerve)",
      "at": {
        "u": 18.4,
        "v": 0.7
      },
      "palpation": "Behind the medial epicondyle: the hollow in which the ulnar nerve can be rolled under the fingertip (a tingle to the little finger)."
    },
    {
      "id": "anterior-axillary-fold",
      "label": "end of the anterior axillary fold",
      "at": {
        "u": -0.6,
        "v": 20.7
      },
      "palpation": "With the arm at the side, follow the lower border of pectoralis major to where the fold meets the front of the arm."
    },
    {
      "id": "biceps-lateral-border-fold-level",
      "label": "lateral border of biceps brachii, level with the end of the anterior axillary fold",
      "at": {
        "u": 3.5,
        "v": 20.7
      },
      "palpation": "Level with the end of the anterior axillary fold, the groove along the lateral edge of biceps (tense the muscle to find it)."
    },
    {
      "id": "posterior-axillary-fold",
      "label": "end of the posterior axillary fold",
      "at": {
        "u": 16.2,
        "v": 19.8
      },
      "palpation": "With the arm at the side, follow the fold at the back of the armpit (teres major and latissimus dorsi) to where it meets the arm."
    },
    {
      "id": "axillary-fossa-centre",
      "label": "centre of the axillary fossa",
      "at": {
        "u": -7.5,
        "v": 24.5
      },
      "palpation": "With the arm abducted: the deepest point of the hollow of the armpit, between the two axillary folds, where the axillary pulse is felt."
    },
    {
      "id": "deltoid-insertion",
      "label": "deltoid tuberosity (lower apex of the deltoid)",
      "at": {
        "u": 6.6,
        "v": 16.6
      },
      "palpation": "Abduct the arm against resistance: the lower point of the V of the deltoid on the outer arm, about half-way down the humerus."
    },
    {
      "id": "greater-tubercle",
      "label": "greater tubercle of the humerus",
      "at": {
        "u": 6.6,
        "v": 27.8
      },
      "palpation": "Below the lateral border of the acromion, the most lateral bony point of the shoulder; it rolls under the finger when the arm is rotated."
    },
    {
      "id": "acromion-anterior",
      "label": "anterior end of the lateral border of the acromion",
      "at": {
        "u": 4.8,
        "v": 30.4
      },
      "palpation": "Follow the lateral border of the acromion forwards to its front corner."
    },
    {
      "id": "acromion-lateral",
      "label": "midpoint of the lateral border of the acromion",
      "at": {
        "u": 7.8,
        "v": 30.9
      },
      "palpation": "The flat bony shelf at the top of the shoulder; its outer edge."
    },
    {
      "id": "acromial-angle",
      "label": "acromial angle (posterolateral corner of the acromion)",
      "at": {
        "u": 11.4,
        "v": 29.8
      },
      "palpation": "Follow the spine of the scapula laterally to where it turns forwards into the lateral border of the acromion."
    },
    {
      "id": "acromion-anterior-depression",
      "label": "depression anterior and inferior to the acromion, between it and the greater tubercle",
      "at": {
        "u": 5.7,
        "v": 29.1
      },
      "palpation": "Abduct the arm: two hollows appear at the shoulder; this is the anterior one, between the front of the acromion and the greater tubercle."
    },
    {
      "id": "acromioclavicular-joint",
      "label": "acromioclavicular joint",
      "at": {
        "u": 5.8,
        "v": 33.4
      },
      "palpation": "On top of the shoulder, the small step where the lateral end of the clavicle meets the acromion."
    },
    {
      "id": "clavicle-spine-notch",
      "label": "depression between the lateral end of the clavicle and the spine of the scapula",
      "at": {
        "u": 8.4,
        "v": 35.2
      },
      "palpation": "On top of the shoulder, medial to the acromion: the V-shaped hollow between the clavicle in front and the spine of the scapula behind."
    },
    {
      "id": "scapular-spine-lower-border",
      "label": "lower border of the spine of the scapula, directly above the end of the posterior axillary fold",
      "at": {
        "u": 16.2,
        "v": 28.4
      },
      "palpation": "Follow the posterior axillary fold straight up to the lower edge of the bony spine of the scapula."
    },
    {
      "id": "coracoid-process",
      "label": "coracoid process",
      "at": {
        "u": -0.4,
        "v": 30.8
      },
      "palpation": "Deep in the groove between deltoid and pectoralis major, one finger-breadth below the clavicle; tender on firm pressure."
    }
  ],
  "segments": [
    {
      "id": "seg.arm",
      "label": "end of the anterior axillary fold to the cubital crease",
      "from": "anterior-axillary-fold",
      "to": "cubital-crease-mid",
      "cun": 9,
      "source": {
        "title": "WHO Standard Acupuncture Point Locations (2008): proportional bone measurement, upper limb",
        "verified": false,
        "note": "The standard gives 9 B-cun from the anterior or posterior axillary fold to the cubital crease; the posterior arm uses the same cun."
      }
    }
  ],
