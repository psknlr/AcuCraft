{
  "schema": "acucraft/region@1",
  "id": "hand-palm",
  "version": "0.1.0",
  "title": "palm of the hand, palmar fingers and fingertips",
  "laterality": "bilateral",
  "chart": {
    "description": "The palm and the palmar surface of the fingers. u: distance (cm) from the axis of the third metacarpal, positive towards the radial (thumb) side, negative towards the ulnar side. v: distance (cm) proximal from the level of the heads of the metacarpals (the metacarpophalangeal joints), positive towards the wrist (the distal palmar wrist crease at about +8.5), negative along the fingers to the fingertips (the middle fingertip at about -10). The thumb runs distally and radially from its metacarpophalangeal joint at about (6.4, 2.6). d: depth below the skin (cm).",
    "uRange": [
      -6,
      10
    ],
    "vRange": [
      -12,
      11
    ]
  },
  "reference": {
    "heightCm": 170,
    "bmi": 22.5
  },
  "configurations": [
    {
      "id": "supinated",
      "label": "hand supinated, palm up, fingers relaxed and supported"
    }
  ],
  "defaultConfiguration": "supinated",
  "access": [
    {
      "position": "seated",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "supine-knee-flexed",
      "configuration": "supinated",
      "sides": [
        "left",
        "right"
      ]
    },
    {
      "position": "side-lying-left",
      "configuration": "supinated",
      "sides": [
        "right"
      ]
    },
    {
      "position": "side-lying-right",
      "configuration": "supinated",
      "sides": [
        "left"
      ]
    }
  ],
  "landmarks": [
    {
      "id": "mc3-head-palmar",
      "label": "level of the head of the third metacarpal, felt through the palm",
      "at": {
        "u": 0.0,
        "v": 0.0
      },
      "palpation": "Press into the palm just proximal to the base of the middle finger: the rounded head of the metacarpal."
    },
    {
      "id": "proximal-palmar-crease-2-3",
      "label": "proximal transverse palmar crease where it crosses the space between the second and third metacarpals",
      "at": {
        "u": 0.95,
        "v": 2.4
      },
      "palpation": "Make a loose fist: the tip of the middle finger rests here, between the second and third metacarpals."
    },
    {
      "id": "distal-palmar-crease-4-5",
      "label": "distal transverse palmar crease where it crosses the space between the fourth and fifth metacarpals",
      "at": {
        "u": -2.7,
        "v": 1.5
      },
      "palpation": "Make a loose fist: the tip of the little finger rests here, between the fourth and fifth metacarpals."
    },
    {
      "id": "mc1-base",
      "label": "base of the first metacarpal (carpometacarpal joint of the thumb)",
      "at": {
        "u": 3.6,
        "v": 7.6
      },
      "palpation": "Slide proximally along the thumb metacarpal over the thenar eminence to the joint at its base."
    },
    {
      "id": "mc1-head",
      "label": "head of the first metacarpal (metacarpophalangeal joint of the thumb)",
      "at": {
        "u": 6.4,
        "v": 2.6
      },
      "palpation": "The joint at the base of the thumb, felt on its palmar side."
    },
    {
      "id": "pisiform",
      "label": "pisiform",
      "at": {
        "u": -3.8,
        "v": 8.2
      },
      "palpation": "The pea-shaped bone at the ulnar end of the distal wrist crease."
    },
    {
      "id": "scaphoid-tubercle",
      "label": "tubercle of the scaphoid",
      "at": {
        "u": 2.6,
        "v": 8.1
      },
      "palpation": "At the radial end of the distal wrist crease, the bony prominence at the base of the thenar eminence."
    },
    {
      "id": "hook-of-hamate",
      "label": "hook of the hamate (deep)",
      "at": {
        "u": -2.4,
        "v": 6.6
      },
      "palpation": "One finger-breadth distal and radial to the pisiform, felt with firm pressure."
    },
    {
      "id": "palmar-wrist-crease-mid",
      "label": "midpoint of the distal palmar wrist crease",
      "at": {
        "u": 0.2,
        "v": 8.5
      },
      "palpation": "The most distal of the creases on the front of the wrist; its middle."
    },
    {
      "id": "pip-crease-2",
      "label": "centre of the palmar crease of the proximal interphalangeal joint of the index finger",
      "at": {
        "u": 2.04,
        "v": -4.5
      },
      "palpation": "Flex the finger slightly: the crease at the first finger joint; its middle."
    },
    {
      "id": "pip-crease-3",
      "label": "centre of the palmar crease of the proximal interphalangeal joint of the middle finger",
      "at": {
        "u": 0.0,
        "v": -5.0
      }
    },
    {
      "id": "pip-crease-4",
      "label": "centre of the palmar crease of the proximal interphalangeal joint of the ring finger",
      "at": {
        "u": -1.99,
        "v": -4.8
      }
    },
    {
      "id": "pip-crease-5",
      "label": "centre of the palmar crease of the proximal interphalangeal joint of the little finger",
      "at": {
        "u": -3.92,
        "v": -3.4
      }
    },
    {
      "id": "tip-1",
      "label": "tip of the thumb",
      "at": {
        "u": 8.31,
        "v": -2.83
      },
      "palpation": "The centre of the tip, just beyond the free edge of the nail."
    },
    {
      "id": "tip-2",
      "label": "tip of the index finger",
      "at": {
        "u": 2.3,
        "v": -8.9
      },
      "palpation": "The centre of the tip, just beyond the free edge of the nail."
    },
    {
      "id": "tip-3",
      "label": "tip of the middle finger",
      "at": {
        "u": 0.0,
        "v": -9.9
      },
      "palpation": "The centre of the tip, just beyond the free edge of the nail."
    },
    {
      "id": "tip-4",
      "label": "tip of the ring finger",
      "at": {
        "u": -2.2,
        "v": -9.5
      },
      "palpation": "The centre of the tip, just beyond the free edge of the nail."
    },
    {
      "id": "tip-5",
      "label": "tip of the little finger",
      "at": {
        "u": -4.3,
        "v": -7.1
      },
      "palpation": "The centre of the tip, just beyond the free edge of the nail."
    }
  ],
