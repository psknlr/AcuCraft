{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@clinicalcraft/core": ["./.deps/clinicalcraft/packages/core/src/index.ts"],
      "@clinicalcraft/world": ["./.deps/clinicalcraft/packages/world/src/index.ts"],
      "@clinicalcraft/web/*": ["./.deps/clinicalcraft/packages/web/src/*"],
      "@acucraft/core": ["./packages/core/src/index.ts"],
      "@acucraft/agent": ["./packages/agent/src/index.ts"],
      "@acucraft/agent/node": ["./packages/agent/src/node/index.ts"],
      "@acucraft/bench": ["./packages/bench/src/index.ts"],
      "@acucraft/mcp": ["./packages/mcp/src/index.ts"],
      "@acucraft/server": ["./packages/server/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/server/web", "tools/*.ts", "vitest.config.ts"]
}
